{
  "name": "layerbridge",
  "displayName": "Layerbridge",
  "description": "Read, edit and export the Figma file open in the bridge plugin: MCP server plus skills for implementing designs, building in Figma, design-system audits, tokens, assets and troubleshooting.",
  "author": {
    "name": "Murad Yousuf",
    "url": "https://github.com/muradyf"
  },
  "homepage": "https://github.com/muradyf/layerbridge#readme",
  "repository": "https://github.com/muradyf/layerbridge",
  "license": "MIT",
  "keywords": ["figma", "design", "mcp", "design-tokens", "design-to-code"],
  "mcpServers": {
    "layerbridge": {
      "command": "npx",
      "args": ["-y", "layerbridge@latest"],
      "env": {
        "FIGMA_BRIDGE_OUTPUT_ROOTS": "${CLAUDE_PROJECT_DIR}"
      }
    }
  }
}
