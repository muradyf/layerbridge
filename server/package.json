{
  "name": "figma-bridge-ours",
  "version": "0.2.0",
  "description": "Local MCP server and plugin that let AI tools read, edit and export the open Figma file — no REST API, no rate limits",
  "mcpName": "io.github.muradyf/REPLACE-ME",
  "type": "module",
  "bin": {
    "figma-bridge-ours": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "!dist/**/*.map",
    "plugin",
    "NOTICE.md",
    "LICENSE.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "bundle-plugin": "node scripts/bundle-plugin.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muradyf/REPLACE-ME.git",
    "directory": "server"
  },
  "homepage": "https://github.com/muradyf/REPLACE-ME#readme",
  "bugs": {
    "url": "https://github.com/muradyf/REPLACE-ME/issues"
  },
  "keywords": [
    "figma",
    "mcp",
    "model-context-protocol",
    "ai",
    "design"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "pdf-lib": "1.17.1",
    "ws": "^8.18.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
