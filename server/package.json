{
  "name": "figma-bridge-ours",
  "version": "0.2.0",
  "description": "Local MCP server and plugin that let AI tools read, edit and export the open Figma file — no REST API, no rate limits",
  "type": "module",
  "bin": {
    "figma-bridge-ours": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "NOTICE.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --test --test-concurrency=1 test/*.test.mjs"
  },
  "keywords": [
    "figma",
    "mcp",
    "model-context-protocol",
    "ai",
    "design"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "pdf-lib": "1.17.1",
    "pngjs": "7.0.0",
    "ws": "^8.18.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pngjs": "6.0.5",
    "@types/ws": "^8.5.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "private": true
}
